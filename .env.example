# ---------------------------------------------------------------------------
# My Quant Lab — 复制本文件为 .env 后修改。
# 唯一需要你手动创建的文件就是 .env（名字前面有点，没有扩展名）。
#   cp .env.example .env
#
# 必填两项（否则容器无法启动）：
#   POSTGRES_PASSWORD   数据库密码，随便设一个强密码
#   SECRET_KEY          用 `openssl rand -hex 32` 生成，或直接填 32 位随机字符串
# ---------------------------------------------------------------------------

# --- 必填 -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-password
SECRET_KEY=change-me-openssl-rand-hex-32

# --- 数据库 / 缓存（一般不用改） -----------------------------------------
POSTGRES_USER=quantlab
POSTGRES_DB=quantlab

# --- 端口 -----------------------------------------------------------------
# Web 界面对外端口，浏览器访问 http://<NAS-IP>:8081
WEB_BIND=0.0.0.0
WEB_PORT=8081
# API 只绑定本机，由 Web 容器代理 /api，避免无认证暴露
# （若要从局域网直连 API，请自行加反向代理与认证）
API_BIND=127.0.0.1
API_PORT=8080

# --- 镜像策略（默认本地构建，无需任何仓库账号） ---------------------------
# 保持下面两行的默认值即可：界面点"构建"或执行 docker compose build 时，
# 会在本机完成镜像构建。
#
# 如果你想用 GitHub Packages 上的预构建镜像（可选）：
#   仓库是私有的，必须先登录，否则会报 unauthorized：
#     echo "$GITHUB_TOKEN" | docker login ghcr.io -u <你的GitHub用户名> --password-stdin
#   然后把下面三行改成：
#     MQL_PULL_POLICY=always
#     MQL_BACKEND_IMAGE=ghcr.io/bobvane/my-quant-lab-backend:v0.0.6
#     MQL_WEB_IMAGE=ghcr.io/bobvane/my-quant-lab-web:v0.0.6
MQL_PULL_POLICY=never
MQL_BACKEND_IMAGE=my-quant-lab-backend:local
MQL_WEB_IMAGE=my-quant-lab-web:local

# --- 运行环境 -------------------------------------------------------------
APP_ENVIRONMENT=production
LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# --- 行情数据 -------------------------------------------------------------
# synthetic      = 离线确定性演示数据，无需任何 API Key，开箱即用
# yahoo_finance  = 真实免费行情（仍需在镜像里安装 market-data 附加依赖）
MARKET_DATA_PROVIDER=synthetic

# --- 其他 -----------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:8081

# --- AI（可选，仅用于解释，不参与任何数值计算） ---------------------------
# 不填也能正常运行：所有量化功能照常工作，只是没有自然语言解释。
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=
AI_DAILY_BUDGET_USD=2.0

# --- Ghostfolio（可选，只读） --------------------------------------------
GHOSTFOLIO_BASE_URL=
GHOSTFOLIO_API_KEY=
