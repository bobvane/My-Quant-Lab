# My Quant Lab — deployment configuration
#
# Copy this file to `.env` in the same directory as docker-compose.yml and fill
# in the three REQUIRED values below. The file is read twice: by Docker Compose
# for interpolation, and by the containers themselves as their runtime config.
#
# Never commit the resulting .env.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# PostgreSQL superuser password for the bundled database.
POSTGRES_PASSWORD=

# Signs login sessions. Must be at least 10 characters and must not be the
# upstream default; the API refuses to start otherwise.
SECRET_KEY=

# Encrypts exchange API secrets at rest. Changing it makes stored credentials
# unreadable, so keep a copy somewhere safe.
CREDENTIAL_ENCRYPTION_KEY=

# First administrator account, created on first start. Changing these later has
# no effect on an existing database.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# The only port that needs to be reachable from the LAN.
FRONTEND_PORT=8888
# Bind to a specific address instead of all interfaces if you prefer.
# FRONTEND_HOST=0.0.0.0

# Comma-separated origins allowed to call the API directly. Only needed when a
# browser reaches the API without going through the web container's /api proxy.
# FRONTEND_URL=http://localhost:8888,http://192.168.1.10:8888

# ---------------------------------------------------------------------------
# Images (pinned; change deliberately)
# ---------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/openbyteinc/quantdinger-backend
BACKEND_TAG=5.6.1
FRONTEND_IMAGE=ghcr.io/openbyteinc/quantdinger-frontend
FRONTEND_TAG=5.6.1

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# Resource tuning (safe defaults for a 16 GB NAS)
# ---------------------------------------------------------------------------
PG_MAX_CONNECTIONS=150
PG_SHARED_BUFFERS=256MB
WORKER_DB_POOL_MIN=2
WORKER_DB_POOL_MAX=12
TRADING_DB_POOL_MIN=4
TRADING_DB_POOL_MAX=32
CELERY_CONCURRENCY=2
REDIS_CACHE_MAXMEMORY=128mb
REDIS_JOBS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Local network / proxy
# ---------------------------------------------------------------------------
# If the NAS reaches the internet through an HTTP proxy, set these. Leave empty
# to connect directly. Docker containers do not inherit the host's proxy.
# HTTPS_PROXY=http://192.168.1.1:7890
# HTTP_PROXY=http://192.168.1.1:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,redis-jobs,backend,frontend
