# My Quant Lab —— 部署配置
#
# 把这个文件复制成同目录下的 `.env`，然后填好下面三个【必填】值。
# 这个文件会被读两次：一次由 Docker Compose 做变量替换，
# 一次由容器自己当运行时配置读取。
#
# 生成出来的 .env 绝对不要提交到仓库。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------
# 内置数据库的 PostgreSQL 超级用户密码。
POSTGRES_PASSWORD=

# 用于给登录会话签名。至少 10 个字符，且不能沿用上游默认值，
# 否则接口会拒绝启动。
SECRET_KEY=

# 把交易所 API 密钥加密后存库。一旦改动，已保存的密钥就解不开了，
# 所以务必另存一份。
CREDENTIAL_ENCRYPTION_KEY=

# 第一个管理员账号，首次启动时创建。数据库建好之后再改这几项不起作用。
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# 网页
# ---------------------------------------------------------------------------
# 唯一需要让局域网访问的端口。
FRONTEND_PORT=8888
# 想只绑定某一张网卡就取消下面这行的注释并改成对应地址。
# FRONTEND_HOST=0.0.0.0

# 允许直接调用接口的来源，逗号分隔。只有当浏览器绕开网页容器的 /api 代理、
# 直连后端时才需要填。
# FRONTEND_URL=http://localhost:8888,http://192.168.1.10:8888

# ---------------------------------------------------------------------------
# 镜像（版本固定，改动请慎重）
# ---------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/openbyteinc/quantdinger-backend
BACKEND_TAG=5.6.1
FRONTEND_IMAGE=ghcr.io/openbyteinc/quantdinger-frontend
FRONTEND_TAG=5.6.1

# ---------------------------------------------------------------------------
# 时区
# ---------------------------------------------------------------------------
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 资源参数（16 GB 内存 NAS 的安全默认值）
# ---------------------------------------------------------------------------
PG_MAX_CONNECTIONS=150
PG_SHARED_BUFFERS=256MB
WORKER_DB_POOL_MIN=2
WORKER_DB_POOL_MAX=12
TRADING_DB_POOL_MIN=4
TRADING_DB_POOL_MAX=32
CELERY_CONCURRENCY=2
REDIS_CACHE_MAXMEMORY=128mb
REDIS_JOBS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# 本机网络 / 代理
# ---------------------------------------------------------------------------
# 如果 NAS 需要通过 HTTP 代理上网，就填这两项；直连则保持注释状态。
# 容器不会继承宿主机的代理设置，必须在这里单独给。
# 只填 7890 / 7891 / 7893 这类能用端口，不要用 7892（redir）和 7895（tproxy），
# 那两个只有路由器自己能用。
# HTTPS_PROXY=http://192.168.1.1:7890
# HTTP_PROXY=http://192.168.1.1:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,redis-jobs,backend,frontend
