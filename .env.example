# ---------------------------------------------------------------------------
# My Quant Lab — copy to .env and edit. NEVER commit .env
# ---------------------------------------------------------------------------

# Version tag used for image names (set by the release workflow / version.sh)
MQL_VERSION=latest

APP_ENVIRONMENT=production
LOG_LEVEL=INFO

# --- required -------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_USER=quantlab
POSTGRES_DB=quantlab

# --- exposed ports --------------------------------------------------------
# The web UI is the only service you normally need to reach from the LAN.
WEB_BIND=0.0.0.0
WEB_PORT=8081
# The API is bound to localhost on purpose; the web container proxies /api.
API_BIND=127.0.0.1
API_PORT=8080

# --- market data ----------------------------------------------------------
# synthetic = deterministic offline demo data (no API key needed)
# yahoo_finance = real free quotes (requires the market-data extra)
MARKET_DATA_PROVIDER=synthetic

# --- AI layer (optional, advisory only) ----------------------------------
# Any OpenAI-compatible endpoint works. Leave blank to run without AI;
# quantitative features keep working when AI is disabled.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=
AI_DAILY_BUDGET_USD=2.0

# --- Ghostfolio (optional, read-only) -------------------------------------
GHOSTFOLIO_BASE_URL=
GHOSTFOLIO_API_KEY=

# --- misc -----------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
CELERY_CONCURRENCY=2
