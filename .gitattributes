# Normalise line endings: shell scripts and Docker files must keep LF or they
# break inside Linux containers.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.example text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.docx binary
