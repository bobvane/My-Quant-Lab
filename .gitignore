# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
secrets/
config/local.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.vite/
# `vue-tsc -b` (npm run build) writes an incremental build cache next to the
# sources; it must never be committed.
*.tsbuildinfo

# Database / volumes
*.db
*.sqlite3
# SQLite write-ahead / journal sidecars of the throwaway local verification
# database (`backend/.local-verify.sqlite3`); `*.sqlite3` does not match them.
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
postgres_data/
redis_data/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local scratch: throwaway notes, drafts and one-off scripts that belong to the
# project directory but must never reach a commit or CI (m21997).  Anything worth
# keeping is written as a real document under docs/ instead.
.scratch/
