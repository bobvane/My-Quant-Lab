# My Quant Lab — API / worker / scheduler share this image.
# The entrypoint selects the role so a single build is reused everywhere.

# cloudflared backs the on-demand "temporary remote access" tunnel (ADR-125). It
# comes from the upstream image rather than a run-time download, so the binary in
# production is exactly the one this file pins, and the API container needs no
# network access to obtain it. Only the binary is copied: the API image stays the
# final stage, and cloudflared gains no package manager, no shell tooling and no
# privileges from this stage.
FROM cloudflare/cloudflared:2026.9.3 AS cloudflared

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# libpq for psycopg, curl for healthchecks, procps for the scheduler's `pgrep`
# probe. Without procps that probe exited 127 forever, so quantlab-scheduler sat
# at `unhealthy` in every deployment while `docker compose up -d` still reported
# success (ADR-099).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 curl procps \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first so code edits do not invalidate the layer
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend/ /app/
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
# The tunnel binary is owned by root and executable by everyone: the API runs as
# uid 10001 and must be able to exec it, but must not be able to replace it.
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chmod 755 /usr/local/bin/cloudflared \
    && useradd --create-home --uid 10001 quantlab \
    && chown -R quantlab:quantlab /app

USER quantlab

ENV APP_ROLE=api \
    PORT=8080

EXPOSE 8080

# No HEALTHCHECK here on purpose. docker-compose.yml declares one for every
# service it starts, and the probe belongs to the role, not to the shared image:
# this image also runs the Celery worker and beat, which have no HTTP server, so
# a curl probe could never pass for them. The two copies that used to exist here
# and in compose disagreed about the budget (30s/5 vs 45s/6) and only one of them
# ever ran (ADR-100). Running this image without compose? Pass --health-cmd.

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
