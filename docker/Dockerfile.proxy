# Quant Lab read-only Docker stats proxy (ADR-024).
#
# Standard library only: no fastapi, no docker SDK. The docker socket is
# mounted READ-ONLY into this one isolated container; every request is filtered
# against a strict whitelist before it reaches the daemon.
FROM python:3.12-alpine

ENV PYTHONUNBUFFERED=1 \
    PROXY_PORT=9100

WORKDIR /app
COPY docker/readonly_proxy.py /app/readonly_proxy.py

# Root on purpose, and docker-compose.yml no longer overrides it: the Docker
# socket is owned by root with a GID that differs across NAS platforms, so a
# static `group_add` is fragile. It is safe because readonly_proxy.py limits the
# process to two GET endpoints, the port is never published, and container root
# is not host root (ADR-024, ADR-100).
USER root

EXPOSE 9100

# The probe is declared in docker-compose.yml, next to the socket mount it
# checks (ADR-100).

CMD ["python", "-u", "readonly_proxy.py"]
